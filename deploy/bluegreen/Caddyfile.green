{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@public_metrics path /api/metrics
	respond @public_metrics 404

	handle_path /api/* {
		reverse_proxy api-green:8000 {
			health_uri /ready
			health_interval 10s
			health_timeout 3s
		}
	}

	handle /ws/* {
		reverse_proxy api-green:8000
	}

	@public_uploads path /uploads/announcements/* /uploads/merchandise-submissions/templates/* /uploads/surveys/* /uploads/public-site/* /uploads/recommended-vendors/*
	handle @public_uploads {
		header Cache-Control "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800"
		reverse_proxy api-green:8000
	}

	handle /uploads/* {
		header Cache-Control "no-store"
		reverse_proxy api-green:8000
	}

	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy web-green:3000
	}

	handle /_next/image* {
		header Cache-Control "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
		reverse_proxy web-green:3000
	}

	handle /auth/google/* {
		reverse_proxy api-green:8000
	}

	handle /auth/discord/* {
		reverse_proxy api-green:8000
	}

	handle /health {
		reverse_proxy api-green:8000
	}

	handle /ready {
		reverse_proxy api-green:8000
	}

	handle /live {
		reverse_proxy api-green:8000
	}

	handle {
		reverse_proxy web-green:3000
	}
}
