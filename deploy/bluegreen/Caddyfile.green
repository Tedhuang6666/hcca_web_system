{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# 在回應送出前覆寫上游同名欄位，避免 Next/FastAPI 與 Caddy 重複設定。
		>Referrer-Policy "strict-origin-when-cross-origin"
		>X-Content-Type-Options "nosniff"
		>Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		>Cross-Origin-Opener-Policy "same-origin"
		>Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# 公開財務憑證 API 自行設定 SAMEORIGIN 與 frame-ancestors 'self'；
	# 其餘路徑由 Caddy 強制 DENY，避免覆蓋憑證預覽所需的同源 iframe 標頭。
	@not_public_finance_evidence {
		not path_regexp ^/api/finance/public/budgets/[^/]+/(expenses|expense-claims)/[^/]+/evidence/[^/]+$
	}
	header @not_public_finance_evidence >X-Frame-Options "DENY"

	@theme_asset path /theme.js
	header @theme_asset Cache-Control "public, max-age=604800, stale-while-revalidate=604800"

	# 與 /api/* handle_path 互斥，並攔截 metrics 尾端變體。
	handle /api/metrics* {
		respond 404
	}

	handle_path /api/* {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
			health_uri /live
			health_interval 10s
			health_timeout 3s
		}
	}

	handle /ws/* {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	@public_uploads path /uploads/announcements/* /uploads/merchandise-submissions/templates/* /uploads/surveys/* /uploads/public-site/* /uploads/recommended-vendors/*
	handle @public_uploads {
		header Cache-Control "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800"
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /uploads/* {
		header Cache-Control "no-store"
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /_next/static/* {
		reverse_proxy web-green:3000
	}

	handle /_next/image* {
		header Cache-Control "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
		reverse_proxy web-green:3000
	}

	handle /auth/google/* {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /auth/discord/* {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /health {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /ready {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle /live {
		reverse_proxy api-green:8000 {
			header_up CF-Connecting-IP {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy web-green:3000
	}
}
