# .env.local.example — 本機部署連線設定範例；請複製成 .env.local 後填入實際值
# SECURITY: 實際 .env.local 含主機 IP 與金鑰路徑，已在 .gitignore 排除

# 正式主機 IP 或 hostname
DEPLOY_HOST=

# SSH 登入使用者（通常是 root 或 deploy）
DEPLOY_SSH_USER=root

# SSH 私鑰路徑
DEPLOY_KEY_PATH=$HOME/.ssh/hcca_deploy

# 主機上的 repo 目錄
DEPLOY_DIR=/srv/hcca

# 智慧部署預設值
DEPLOY_BRANCH=main
DEPLOY_REMOTE=origin
DEPLOY_PUSH=1
DEPLOY_WITH_WORKERS=1
DEPLOY_KEEP_OLD=false
DEPLOY_DRAIN_SECONDS=10
DEPLOY_HEALTH_WAIT_SECONDS=300
DEPLOY_IMAGE_WAIT_SECONDS=1200
DEPLOY_MIGRATION_MODE=auto
DEPLOY_REQUIRE_GPG_VERIFY=0
DEPLOY_HEALTH_REPORT_REQUIRED=1
