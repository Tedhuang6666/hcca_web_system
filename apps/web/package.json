{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 114",
    "safari >= 16.4",
    "ios >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run --coverage",
    "validate:share-previews": "node ../../scripts/validate-share-previews.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:module-registry": "node ../../scripts/check-module-registry.mjs",
    "generate:types": "openapi-typescript ../../openapi.json -o ./src/lib/api-types.ts",
    "generate:bridge": "node ../../scripts/generate-bridge.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "@sentry/nextjs": "^10.70.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@types/qrcode": "^1.5.6",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "pdfjs-dist": "^6.2.108",
    "posthog-js": "^1.418.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-spin-roulette": "^1.0.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/diff": "^7.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  },
  "allowScripts": {
    "sharp@0.35.3": true
  }
}
