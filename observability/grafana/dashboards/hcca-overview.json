{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(hcca_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(hcca_http_requests_total[5m])), 0.001) * 100",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ],
      "title": "API 5xx 錯誤率",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hcca_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.75, sum(rate(hcca_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P75",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hcca_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hcca_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99",
          "refId": "D"
        }
      ],
      "title": "API 延遲分位數",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "max(hcca_celery_queue_depth) by (queue)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "title": "Celery Queue 積壓",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path_template) (rate(hcca_db_time_per_request_seconds_bucket[5m])))",
          "legendFormat": "DB p95 {{path_template}}",
          "refId": "A"
        }
      ],
      "title": "DB query time P95 by route",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "options": { "legend": { "displayMode": "list" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (path_template) (rate(hcca_http_slow_requests_total[5m]))",
          "legendFormat": "slow {{path_template}}",
          "refId": "A"
        },
        {
          "expr": "sum by (path_template) (rate(hcca_http_timeouts_total[5m]))",
          "legendFormat": "timeout {{path_template}}",
          "refId": "B"
        }
      ],
      "title": "Slow requests / timeouts",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "options": { "textMode": "name", "colorMode": "value" },
      "targets": [{
        "expr": "max by (release, commit_sha, environment) (hcca_build_info)",
        "legendFormat": "{{environment}} {{release}} {{commit_sha}}",
        "refId": "A"
      }],
      "title": "Current build",
      "type": "stat"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["hcca", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "HCCA Observability Overview",
  "uid": "hcca-observability",
  "version": 1
}
